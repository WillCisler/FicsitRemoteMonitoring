// =============================================================================
// FACTORY ITEMS DIMENSION TABLE
// =============================================================================
// Purpose: Master reference table for all items in the factory system
// Business Context: Engineering-003 - Production Optimisation (Reference Data)
// Data Source: Derived from production_items and external game data
// Update Frequency: On-demand updates when new items are discovered
// =============================================================================

// Drop existing table if it exists (for clean deployment)
.drop table factory_items ifexists

// Create the factory_items dimension table
.create table factory_items (
    item_name: string,                      // Display name of the item
    item_class: string,                     // Class name of the item
    item_category: string,                  // Category: "raw_material", "intermediate", "final_product", "tool", "equipment"
    item_subcategory: string,               // Subcategory for finer classification
    is_extractable: bool,                   // True for items that can be extracted from world nodes
    is_manufacturable: bool,                // True for items that can be manufactured
    is_fuel: bool,                          // True for items that can be used as fuel
    is_consumable: bool,                    // True for items that are consumed in production
    base_production_rate: real,             // Standard production rate per minute
    stack_size: long,                       // Maximum stack size for this item
    resource_node_type: string,             // Type of resource node (for extractable items)
    resource_purity: string,                // Resource purity level (normal, impure, pure)
    energy_value: real,                     // Energy value if used as fuel (MJ)
    sink_points: long,                      // Points awarded when sent to resource sink
    unlock_tier: long,                      // Tier when this item becomes available
    requires_research: bool,                // Whether item requires research to unlock
    item_description: string,               // Business-friendly description
    production_chain_level: long,           // Level in production chain (0=raw, 1=tier1, etc.)
    complexity_score: real,                 // Complexity rating for production planning
    market_value: real,                     // Relative market/resource value
    storage_requirements: string,           // Special storage requirements
    transportation_method: string,          // Preferred transportation method
    quality_variants: dynamic,              // Array of quality variants if applicable
    recipe_inputs: dynamic,                 // Array of input items for manufacturing
    recipe_outputs: dynamic,                // Array of output items from manufacturing
    alternative_recipes: dynamic,           // Array of alternative recipe names
    production_buildings: dynamic,          // Array of buildings that can produce this item
    last_updated: datetime,                 // When this record was last updated
    data_source: string,                    // Source of the data (game_data, user_input, derived)
    is_active: bool                         // Whether this item is currently active in the game
)

// Set table description for business users
.alter table factory_items docstring "Master reference table for all factory items and resources. Provides comprehensive metadata for production planning, resource classification, and supply chain optimization."


// Set data retention policy (indefinite for reference data)
.alter table factory_items policy retention ```
{
    "SoftDeletePeriod": "3650.00:00:00",
    "Recoverability": "Enabled"
}
```

