{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Satisfactory": {
        "FrmUrl": "http://localhost:8080",
        "ServerName": "dev-server"
    },
    "Streaming": {
        "HighFrequencyIntervalSeconds": 2,
        "MediumFrequencyIntervalSeconds": 10,
        "StandardFrequencyIntervalSeconds": 60,
        "MaxItemsPerChunk": 50,
        "ChunkingExcludedEndpoints": [ "getSessionInfo" ]
    },
    "Endpoints": {
        "StandardFrequency": [
            "getFactory",
            "getBelts",
            "getCables"
        ]
    }
}
